{
  "name": "chat-site-automation",
  "description": "Extension navigateur pour détecter les champs de chat, apprendre les procédures par site et journaliser les tentatives.",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:chrome": "wxt build --browser chrome",
    "build:firefox": "wxt build --browser firefox --mv3",
    "build:edge": "wxt build --browser edge",
    "build:all": "npm run build:chrome && npm run build:firefox && npm run build:edge",
    "build:zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser-extension.smoke.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wxt": "^0.21.4"
  }
}
